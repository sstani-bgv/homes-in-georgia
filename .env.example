# Homes in Georgia platform — every variable (docs/ARCHITECTURE.md §2). Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://homes:homes@db:5432/homes
TEST_DATABASE_URL=postgresql+psycopg://homes:homes@db:5432/homes_test
# JWT signing key
SECRET_KEY=   # required: random 32+ chars, e.g. `openssl rand -hex 32`
JWT_TTL_HOURS=72
# Mini App links / calendar links
PUBLIC_URL=https://crm.example.com
# @HomesinGeorgia_bot token from BotFather
BOT_TOKEN=
BOT_USERNAME=HomesinGeorgia_bot
# after ❤️ the client writes to this operator (t.me/<username>?text=…); empty = the first operator's @username in the CRM
OPERATOR_TG_USERNAME=
# operator userbot (backend/app/telegram/userbot.py), needed to send viewing slots to clients: all three set = enabled;
# the operator creates the session themselves (docs/DEPLOY.md «Один бот и userbot оператора»). The bot needs inline mode
# (BotFather /setinline): the userbot sends the bot's inline result with the slot buttons.
OPERATOR_USERBOT_SESSION=
API_ID=
API_HASH=
USERBOT_URL=   # e.g. http://userbot:8091 in compose; empty = «Userbot оператора не подключён» on «Отправить клиенту»
# Set to 0 during review to avoid forwarding historic channel videos into staff chats.
VIDEO_BACKFILL=1
# overridable for tests (fake Bot API)
TG_API_BASE=https://api.telegram.org
# operators group (lead cards, B1)
OPERATORS_CHAT_ID=
# optional forum topic in that group
OPERATORS_TOPIC_ID=
# agency work group with topics (reports, #Rented, T14)
WORK_GROUP_CHAT_ID=
TOPIC_PHOTO=
TOPIC_SHOWING=
TOPIC_STICKERS=
TOPIC_DEAL=
TOPIC_T14=
TOPIC_NEWS=
TOPIC_LISTINGS=
TOPIC_GENERAL=
TOPIC_DAILY=
AGENCY_CHANNEL=rent_tbilisi_ge
# inbound Telegram updates (backend/app/services/inbound.py; the bot must be admin / privacy mode off in the work group)
# numeric id of the agency channel (-100...); empty = match the channel by the AGENCY_CHANNEL username
AGENCY_CHANNEL_ID=
# chat where #Rented deal posts appear (old RENT_CHANNEL_ID); empty = the agency channel
DEALS_CHANNEL_ID=
# chat of the news topic TOPIC_NEWS (old NEWS_CHAT_ID); empty = WORK_GROUP_CHAT_ID
NEWS_CHAT_ID=
# extra work-group topics whose #Rented messages become pending deals, comma-separated (TOPIC_DEAL is always included)
TOPIC_DEAL_EXTRA=
# work-group topics with the Make-Foto template (Address/Agent/Owner/Date/Link), comma-separated
TOPIC_PHOTO_QUEUE=
# channel publishing (object card «Опубликовать»): chat; forum topics for originals, owner contact, album
PUBLISH_CHAT_ID=
PUBLISH_TOPIC_ORIGINALS=
PUBLISH_TOPIC_OWNER=
PUBLISH_TOPIC_ALBUM=
# comma-separated Telegram ids, bootstrap superadmins
SUPERADMIN_TG_IDS=
# first desk login, created on API startup if no superadmin exists
ADMIN_BOOTSTRAP_LOGIN=admin
ADMIN_BOOTSTRAP_PASSWORD=
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=
APIFY_TOKEN=
# Threads source (bot/fetch_threads.py): a long-lived token of a Meta app with threads_keyword_search; used once to seed
# bot/raw/threads_token.json, then refreshed there weekly
THREADS_ACCESS_TOKEN=
GOOGLE_SA_JSON=
SHEET_ID=
TZ=Asia/Tbilisi
SLA_OPERATOR_TAKE_MIN=5
SLA_AGENT_SLOTS_MIN=30
SLA_SLOTS_TO_CLIENT_MIN=60
CLIENT_PROMISE_MIN=30
CALL_RETRY_HOURS=2
VIEWING_REMINDER_MIN=60
POST_VIEWING_SURVEY_MIN=60
T14_DAYS=14
CONTRACT_REMIND_DAYS=30,7,1
MEDIA_DIR=/app/data/media
# CRM photos/videos: local (files under MEDIA_DIR, default) or s3 (Cloudflare R2 / Hetzner / MinIO bucket).
# Move existing files first: docker compose ... exec api sh -c "cd backend && python -m app.storage copy" (docs/DEPLOY.md)
MEDIA_STORAGE=local
# R2: https://<account_id>.r2.cloudflarestorage.com ; Hetzner: https://fsn1.your-objectstorage.com ; MinIO: http://minio:9000
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# R2/MinIO/AWS: us-east-1 ; Hetzner: fsn1 / nbg1 / hel1
S3_REGION=us-east-1
# optional public base URL of the bucket (R2 custom domain / CDN): direct links instead of presigned ones (files become public)
S3_PUBLIC_URL=

# dev only: allow weak SECRET_KEY and CORS for the Vite dev server (never in production)
# APP_ENV=dev
# DEV_CORS=true
